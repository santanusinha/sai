<configuration>
    <property name="LOG_PATH" value="${LOGPATH:-${user.home}/.local/state/sai/logs}" />
    <property name="LOG_LEVEL" value="${LOGLEVEL:-INFO}" />

    <appender name="SESSION_FILE" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
            <key>sessionId</key>
            <defaultValue>default</defaultValue>
        </discriminator>
        <sift>
            <appender name="SESSION-${sessionId}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_PATH}/session-${sessionId}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_PATH}/session-${sessionId}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                    <maxFileSize>10MB</maxFileSize>
                    <maxHistory>30</maxHistory>
                    <totalSizeCap>1GB</totalSizeCap>
                </rollingPolicy>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="SESSION_FILE" />
    </root>
</configuration>
